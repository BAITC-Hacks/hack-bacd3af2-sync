APP_NAME=WindAI
ENV=development
CORS_ORIGINS=http://localhost:5173

# real (default) = ML team's CatBoost models, needs `pip install -r requirements-ml.txt`
# mock = offline power-curve formula — only for development, never for the demo
MODEL_ADAPTER=real
# Optional overrides for MODEL_ADAPTER=real (defaults: <repo>/ml/models and <repo>/ml)
# TURBINE_MODEL_DIR=
# ML_PACKAGE_DIR=
# open_meteo (default) = live weather; mock = synthetic offline weather, development only
WEATHER_PROVIDER=open_meteo

# LLM explanation step (OpenAI). Leave empty to use the built-in template explanation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Language of LLM explanations: ru | en
EXPLANATION_LANGUAGE=ru
