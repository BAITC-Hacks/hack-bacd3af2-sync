APP_NAME=WindAI
ENV=development
CORS_ORIGINS=http://localhost:5173

# mock | real  (real = ML team's CatBoost models; pip install -r requirements-ml.txt)
MODEL_ADAPTER=mock
# Optional overrides for MODEL_ADAPTER=real (defaults: <repo>/ml/models and <repo>/ml)
# TURBINE_MODEL_DIR=
# ML_PACKAGE_DIR=
# mock | open_meteo  (open_meteo falls back to mock weather if the API is unreachable)
WEATHER_PROVIDER=mock

# LLM explanation step (OpenAI). Leave empty to use the built-in template explanation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# en | ru
EXPLANATION_LANGUAGE=en
